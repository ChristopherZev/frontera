# Frontera environment — copy to .env.local and fill in.

# House Anthropic key. Serves the "unlocked" tier and local dev.
# Get one at https://console.anthropic.com — set a spend limit on it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-5).
# CLAUDE_MODEL=claude-sonnet-5

# Password visitors type to unlock live responses on the house key.
DEMO_UNLOCK_PASSWORD=change-me

# Secret used to sign the unlock cookie. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNLOCK_COOKIE_SECRET=change-me-to-a-random-32-byte-hex

# Optional: local DuckDB path for `npm run db` (defaults to data/frontera.duckdb).
# DUCKDB_PATH=data/frontera.duckdb
